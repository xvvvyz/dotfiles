#!/usr/bin/env sh

is_macos() {
  [ "$(uname -s)" = "Darwin" ]
}

is_debian() {
  [ -f /etc/debian_version ]
}

is_wsl() {
  grep -qi microsoft /proc/version 2>/dev/null
}

has_nvidia_gpu() {
  is_wsl || return 1

  # match the pci vendor id rather than the adapter name so this still works
  # before the nvidia driver is installed. cd out of the wsl filesystem to
  # avoid the UNC warning.
  (cd /mnt/c && powershell.exe -NoProfile -NonInteractive -Command 'if (Get-CimInstance Win32_VideoController | Where-Object { $_.PNPDeviceID -like "PCI\VEN_10DE*" }) { exit 0 } exit 1') >/dev/null 2>&1
}

is_windows11() {
  is_wsl || return 1

  # windows 11 is build 22000 and up; windows 10 tops out at 19045.
  (cd /mnt/c && powershell.exe -NoProfile -NonInteractive -Command 'if ([int](Get-CimInstance Win32_OperatingSystem).BuildNumber -ge 22000) { exit 0 } exit 1') >/dev/null 2>&1
}
